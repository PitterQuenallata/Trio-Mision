meta {
  name: Staff importaciones - detalle en procesamiento (espera 1)
  type: http
  seq: 246
}

get {
  url: {{baseUrl}}/api/v1/staff/importaciones/{{importacionDemoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

script:pre-request {
  // Espera real: el worker (make worker-run) sondea cada ~5 s y tarda unos
  // segundos por job; sin esta pausa la primera corrida tras un reset llega
  // al detalle done antes de que el job termine.
  await new Promise(r => setTimeout(r, 8000));
}

assert {
  res.status: eq 200
  res.body.id: eq {{importacionDemoId}}
}

docs {
  Primer detalle mientras el worker (make worker-run en segundo plano)
  procesa el job. Solo se aserta la identidad: el estado se verifica en el
  detalle definitivo más adelante. El pre-request script duerme 8 s para
  dar margen al ciclo de la cola (sondeo + conversión).
}
