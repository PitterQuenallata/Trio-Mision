meta {
  name: Sync - licencia offline de dev con entitlement
  type: http
  seq: 227
}

post {
  url: {{baseUrl}}/api/v1/dispositivos/{{installIdOfflineDev}}/descargas-offline
  body: json
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

body:json {
  {
    "track_ids": [
      "{{pistaId}}"
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("concedida con origen entitlement", function() {
    const b = res.getBody();
    expect(b.concedidas).to.have.lengthOf(1);
    expect(b.concedidas[0].origen).to.equal("entitlement");
    expect(b.rechazadas).to.have.lengthOf(0);
    bru.setEnvVar("licenciaOfflineDevEntitlement", b.concedidas[0].id);
  });
}

docs {
  El usuario principal sí tiene entitlement de la pista 1: la licencia se
  concede con origen entitlement. Es la licencia que la cascada del
  siguiente request revocará.
}
