meta {
  name: Dispositivos - listar propios
  type: http
  seq: 60
}

get {
  url: {{baseUrl}}/api/v1/dispositivos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

assert {
  res.status: eq 200
  res.body.dispositivos: isNotEmpty
}

tests {
  test("la lista incluye el dispositivo web registrado en esta corrida", function() {
    const dispositivos = res.getBody().dispositivos;
    const web = dispositivos.find(d => d.install_id === bru.getVar("installIdWeb"));
    expect(web).to.exist;
    expect(web.estado).to.equal("activo");
  });
}

docs {
  GET /api/v1/dispositivos con el token del comprador: solo dispositivos
  propios, con estado activo/revocado y última actividad.
}
