meta {
  name: Staff importaciones - reintentar job done 409
  type: http
  seq: 256
}

post {
  url: {{baseUrl}}/api/v1/staff/importaciones/{{importacionDemoId}}/reintentar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

assert {
  res.status: eq 409
}

docs {
  Solo los jobs failed admiten reintento: el job demo ya está done y debe
  responder 409.
}
