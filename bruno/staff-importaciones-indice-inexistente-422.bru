meta {
  name: Staff importaciones - índice inexistente 422
  type: http
  seq: 261
}

post {
  url: {{baseUrl}}/api/v1/staff/importaciones/{{importacionDemoId}}/publicar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "indices": [999],
    "destino": {
      "tipo": "album",
      "album_id": "{{albumNuevoId}}"
    }
  }
}

assert {
  res.status: eq 422
}

docs {
  Un índice fuera del resultado se rechaza con 422 antes de tocar el
  catálogo (la tx completa se aborta).
}
