meta {
  name: Negativo - descarga del acceso de servicio ajeno
  type: http
  seq: 187
}

get {
  url: {{baseUrl}}/api/v1/mis-compras/accesos/{{accesoServicioId}}/descarga
  body: none
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

assert {
  res.status: eq 404
}

docs {
  El acceso concedido por la entrega del servicio pertenece solo a su
  titular: otro usuario recibe 404 en la descarga (no se revela su
  existencia).
}
