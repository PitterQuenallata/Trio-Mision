meta {
  name: Servicios - detalle del proyecto con entregas
  type: http
  seq: 184
}

get {
  url: {{baseUrl}}/api/v1/servicios/proyectos/{{proyectoServicioId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{serviciosToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{proyectoServicioId}}
  res.body.estado: eq entregado
  res.body.monto_minor: eq 3500
}

tests {
  test("entregas con URL firmada y pago confirmado", function() {
    const p = res.getBody();
    expect(p.entregas.length).to.equal(3);
    const archivo = p.entregas.find(e => e.tipo === "archivo");
    expect(archivo.archivo.url).to.include("X-Amz-Signature");
    const pistas = p.entregas.filter(e => e.tipo === "pista");
    expect(pistas.length).to.equal(2);
    expect(p.pagos.length).to.equal(1);
    expect(p.pagos[0].estado).to.equal("confirmed");
  });
}

docs {
  El titular ve sus entregas: las de archivo incluyen URL firmada breve
  (nunca en logs) y las de pista quedan disponibles en /mis-compras con
  su entitlement. Los pagos muestran su estado de revisión.
}
