meta {
  name: Artistas - no quitar el último manager (admin, 409)
  type: http
  seq: 431
}

delete {
  url: {{baseUrl}}/api/v1/staff/artistas/{{brunoGrupoId}}/managers/{{managerUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 409
}

docs {
  Regresión de continuidad administrativa: el admin no puede quitar al último
  manager de un artista (409). Usa el grupo creado en esta colección, que tiene un
  único manager (paso anterior), así que no depende de los datos del seed ni de
  otras pruebas. La comprobación se hace bajo bloqueo del artista en la base.
}
