meta {
  name: Tienda - comprobante de pago paquete
  type: http
  seq: 101
}

post {
  url: {{baseUrl}}/api/v1/tienda/pagos/{{pagoPaqueteId}}/comprobante
  body: file
  auth: bearer
}

auth:bearer {
  token: {{comprador2Token}}
}

headers {
  Content-Type: multipart/form-data; boundary=------------------------------triomision
}

body:file {
  file: @file(fixtures/comprobante-multipart.bin) @contentType(multipart/form-data;boundary=------------------------------triomision)
}

assert {
  res.status: eq 200
  res.body.estado: eq in_review
  res.body.byte_size: eq 70
}

docs {
  Comprobante multipart del pago del paquete. Marca el intento en revisión.
}
