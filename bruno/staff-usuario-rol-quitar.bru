meta {
  name: Staff - quitar rol editor a usuario
  type: http
  seq: 413
}

delete {
  url: {{baseUrl}}/api/v1/staff/usuarios/{{bruStaffId}}/roles/editor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.concedido: eq false
}

docs {
  DELETE /api/v1/staff/usuarios/{id}/roles/{rol}: quita el rol (idempotente). Solo admin.
}
