meta {
  name: Negativo - proyecto de servicio ajeno
  type: http
  seq: 168
}

get {
  url: {{baseUrl}}/api/v1/servicios/proyectos/{{proyectoServicioId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

assert {
  res.status: eq 404
}

docs {
  Un usuario ajeno consulta el proyecto de otro → 404. Las entregas con
  archivo solo firman URL tras verificar titularidad.
}
