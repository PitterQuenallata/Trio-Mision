meta {
  name: Tienda - comprobante pago con licencia
  type: http
  seq: 139
}

post {
  url: {{baseUrl}}/api/v1/tienda/pagos/{{pagoLicId}}/comprobante
  body: file
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

headers {
  Content-Type: multipart/form-data; boundary=------------------------------triomision
}

body:file {
  file: @file(fixtures/comprobante-multipart.bin) @contentType(multipart/form-data;boundary=------------------------------triomision)
}

assert {
  res.status: eq 200
  res.body.estado: eq in_review
  res.body.byte_size: eq 70
}

docs {
  Sube el comprobante multipart para el pago con licencia.
}
