meta {
  name: Sync - catalogo pagina 3
  type: http
  seq: 214
}

get {
  url: {{baseUrl}}/api/v1/sync/catalogo?limite=500&desde={{syncCursor2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{gotrueAccessToken}}
}

assert {
  res.status: eq 200
  res.body.cursor: isNotEmpty
}

tests {
  test("pagina 3", function() {
    bru.setEnvVar("syncCursor3", res.getBody().cursor);
  });
}

docs {
  Continuación del sync inicial con el cursor de la página anterior.
}
