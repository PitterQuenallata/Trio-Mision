meta {
  name: Staff - buscar grupos (200)
  type: http
  seq: 427
}

get {
  url: {{baseUrl}}/api/v1/staff/grupos?q=Bruno&limite=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.grupos: isArray
}

docs {
  GET listado con búsqueda y límite (1 a 200).
