import AppTeaser from '@/domains/grupo/sections/AppTeaser.astro'
import Contacto from '@/domains/grupo/sections/Contacto.astro'
---

<Layout>
  <Header />
  <main class="flex flex-1 flex-col">
    <Hero />
    <Historia />
    <SectionDivider />
    <Integrantes />
    <Discografia />
    <AppTeaser />
    <SectionDivider />
    <Contacto />
