---
interface Props {
  eyebrow?: string
  title: string
}

const { eyebrow, title } = Astro.props
---

<div class="flex flex-col items-center gap-3 text-center">
  {
    eyebrow && (
      <span class="text-xs tracking-[0.24em] text-theme-gold">{eyebrow}</span>
    )
  }
  <h2 class="title-gradient text-3xl font-black tracking-[0.1em] md:text-5xl">
    {title}
  </h2>
</div>
