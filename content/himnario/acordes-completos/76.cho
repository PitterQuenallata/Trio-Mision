{title: 76 Eterno Dios, mi Creador}
{key: C}
{time: 4/4}
{lyricist: Isaac Watts, 1719 (1674-1748); Vers. esp.: Walton; J; Brown, 1961 (1913-2001)}
{composer: Sr; William Croft, 1708 (1678-1727)}

{sov}
[C]Eterno[F] Dios, mi[Am] Crea[F]dor,
[G]mi[C] amparo en[Am] aflic[D]ción[G7],
[C]tú has si[F]do[Dm] mi[G] Consola[C]dor
[F]en[E] toda[Dm] oca[F]sión[G][C].
{eov}

{sov}
[C]Mil años[F] a tu[Am] vis[F]ta son
[G]cual[C] brisas del[Am] aye[D]r[G7];
[C]cual hier[F]ba[Dm] es[G] mi condi[C]ción,
[F]pe[E]rece at[Dm]ardece[F]r.[G][C]
{eov}

{sov}
[C]Mi vida[F] bajo[Am] tu[F] ala está,
[G]se[C]guro habi[Am]ta[D]ré[G7];
[C]tu Espí[F]ri[Dm]tu[G] me ayuda[C]rá
[F]y[E] en cal[Dm]ma anda[F]ré[G][C].
{eov}

{sov}
[C]Eterno[F] Dios, mi[Am] Re[F]dentor,
[G]con[C]fío solo[Am] en[D] ti[G7];
[C]sé tú[F] mi[Dm] Guí[G]a, oh Se[C]ñor,
[F]en[E] mi ca[Dm]mino[F] aquí[G][C].
{eov}
