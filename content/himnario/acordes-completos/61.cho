{title: 61 Santo, Santo, Santo, Dios Omnipotente}
{key: D}
{time: 4/4}
{lyricist: Reginald Heber; lBlh 1170 1; Edgar; L; M,ixwPll}
{composer: John B. Dykes, 1861 (1823-1876)}

{sov}
[D]Santo[Bm], Santo[A], San[D]to[G]; Dios Omnipo[D]tente;
[A]canto[D] de ma[Bm]ñana[A] tu ex[D]celsa[A] ma[E]jes[A]tad[A7];
[D]Santo[Bm], Santo[A], San[D]to[G], fuerte y cle[D]mente,
[Bm]Dios[D] sobre[G] to[D]do[D7], Rey[G] de eterni[A7]dad[D].
{eov}

{sov}
[D]Santo[Bm], Santo[A], San[D]to[G]; ángeles te a[D]doran;
[A]echan[D] sus co[Bm]ronas[A] del[D] trono[A] en[E] derre[A]dor[A7];
[D]miles[Bm] y mi[A]llo[D]nes[G] ante ti se[D] postran;
[Bm]tú[D] que e[G]ras[D], y e[D7]res[G], y has de[A7] ser, Se[D]ñor.
{eov}

{sov}
[D]Santo[Bm], Santo[A], San[D]to[G]; aunque estés ve[D]lado,
[A]aunque[D] el o[Bm]jo hu[A]mano[D] tu[A] faz[E] no pue[A]da ver[A7];
