# PostgreSQL
POSTGRES_USER=triomision
POSTGRES_PASSWORD=changeme
POSTGRES_DB=triomision

# Cuenta administrativa solo para migraciones/operación; no la usa la API.
DB_ADMIN_URL=postgres://triomision:changeme@localhost:5432/triomision?sslmode=disable
# Cuentas diarias de servicio (scripts/db-security.sh las crea/actualiza).
API_DB_PASSWORD=changeme-api
GOTRUE_DB_PASSWORD=changeme-gotrue

# GoTrue (autenticación, ver infra/gotrue/README.md)
# Secreto HS256 COMPARTIDO: la API valida los JWT con este mismo valor.
GOTRUE_JWT_SECRET=changeme
# Audiencia del JWT: GoTrue la firma (GOTRUE_JWT_AUD) y la API la exige
# (GOTRUE_JWT_AUDIENCE). Deben coincidir.
GOTRUE_JWT_AUDIENCE=authenticated
# Redirección tras flujos de email (desarrollo local).
GOTRUE_SITE_URL=http://localhost:3000
# Duración del access token en segundos.
GOTRUE_JWT_EXP=3600
# URL pública de GoTrue (API_EXTERNAL_URL); debe ser alcanzable por los clientes.
GOTRUE_API_EXTERNAL_URL=http://localhost:9999

# API
API_PORT=8080
API_ENV=development
API_DATABASE_URL=postgres://triomision_api:changeme-api@localhost:5432/triomision?sslmode=disable
GOTRUE_JWT_AUDIENCE=authenticated

# MinIO root solo para init/administración; S3_* es la cuenta limitada de la API.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Almacenamiento S3 compatible (MinIO en desarrollo, ver compose.yaml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=triomision-media
S3_ACCESS_KEY=triomision-api
S3_SECRET_KEY=changeme-s3
# URL pública base del bucket: se usa para previews públicos (prefijo public/).
S3_PUBLIC_BASE_URL=http://localhost:9000/triomision-media
# Vida de las URLs firmadas de descarga (masters y comprobantes privados).
S3_PRESIGN_TTL=15m
